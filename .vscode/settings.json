{
  "latex-workshop.latex.recipes": [
    {
      "name": "PDFLaTeX (borrador sin citas)",
      "tools": ["pdflatex", "pdflatex"]
    },
    {
      "name": "PDFLaTeX y BibTeX (con citas)",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-halt-on-error", "%DOC%"]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%DOCFILE%"]
    }
  ]
}
